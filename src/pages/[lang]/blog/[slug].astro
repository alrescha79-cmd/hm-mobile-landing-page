---
import type { Lang } from '@/i18n';
import { t } from '@/i18n';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import type { ReleasesCache } from '@/data/types';

interface Props {
  lang: Lang;
  path: string;
  id: string;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: post.data.slug },
    props: {
      lang: post.data.lang,
      path: `/${post.data.lang}/blog/${post.data.slug}`,
      id: post.id,
    },
  }));
}

const { lang, path, id } = Astro.props;
const post = await getEntry('blog', id);
const { title, description, date } = post.data;
const { Content } = await render(post);
const related = (await getCollection('blog'))
  .filter((p) => p.data.lang === lang && !p.data.draft && p.id !== id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const canonical = `https://hm.cakson.my.id/${lang}/blog/${post.data.slug}`;
const cache: ReleasesCache = { fetched: new Date().toISOString(), stars: 0, forks: 0, releases: [] };
const fmtDate = (d: Date) =>
  d.toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base lang={lang} title={`${title} · Huawei Manager`} description={description} canonical={canonical} cache={cache}>
  <Navbar lang={lang} path={path} />
  <main class="pt-28 md:pt-36 px-5 md:px-6 pb-20">
    <article class="mx-auto max-w-3xl">
      <a href={`/${lang}/blog`} class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[color:var(--color-accent-deep)] no-underline whitespace-nowrap mb-8 group">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[var(--dur-micro)] group-hover:-translate-x-0.5" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg>
        {t(lang, 'blog.back')}
      </a>
      <h1 class="text-display-s mb-3">{title}</h1>
      <p class="mono text-[12px] text-[color:var(--color-muted)] mb-10">
        {t(lang, 'blog.published')} · {fmtDate(date)}
      </p>
      <div class="markdown text-[15px] leading-[1.85] text-[color:var(--color-ink)]">
        <Content />
      </div>
    </article>

    {related.length > 0 && (
      <section class="mx-auto max-w-3xl mt-16 pt-10 border-t border-[color:var(--color-rule)]" aria-label={t(lang, 'blog.recommended')}>
        <div class="flex items-center justify-between gap-4 mb-6">
          <h2 class="text-xl font-semibold">{t(lang, 'blog.recommended')}</h2>
          <a href={`/${lang}/blog`} class="shrink-0 inline-flex items-center gap-1 text-[13px] font-semibold text-[color:var(--color-accent-deep)] no-underline whitespace-nowrap hover:underline">
            {t(lang, 'blog.back')}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <a
              href={`/${lang}/blog/${p.data.slug}`}
              class="group flex flex-col rounded-(--radius-lg) border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] p-5 no-underline hover-lift"
            >
              <span class="mono text-[11px] text-[color:var(--color-muted)]">{fmtDate(p.data.date)}</span>
              <h3 class="mt-1.5 text-[15px] font-semibold leading-snug">{p.data.title}</h3>
              <p class="mt-1 line-clamp-2 text-[13px] text-[color:var(--color-muted)]">{p.data.description}</p>
              <span class="mt-auto pt-3 inline-flex items-center gap-1 text-[12px] font-semibold text-[color:var(--color-accent-deep)]">
                {t(lang, 'blog.readMore')}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[var(--dur-micro)] group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer lang={lang} />
</Base>
