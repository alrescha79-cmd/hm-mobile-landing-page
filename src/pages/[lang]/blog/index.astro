---
import type { Lang } from '@/i18n';
import { t } from '@/i18n';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import type { ReleasesCache } from '@/data/types';

interface Props {
  lang: Lang;
  path: string;
}

export function getStaticPaths() {
  return [
    { params: { lang: 'en' }, props: { lang: 'en', path: '/en/blog' } },
    { params: { lang: 'id' }, props: { lang: 'id', path: '/id/blog' } },
  ];
}

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === (Astro.props as Props).lang && !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const { lang, path } = Astro.props;
const canonical = `https://hm.cakson.my.id/${lang}/blog`;
const cache: ReleasesCache = { fetched: new Date().toISOString(), stars: 0, forks: 0, releases: [] };
const fmtDate = (d: Date) =>
  d.toLocaleDateString(lang === 'id' ? 'id-ID' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base lang={lang} title={`${t(lang, 'nav.blog')} · Huawei Manager`} description={t(lang, 'blog.sub')} canonical={canonical} cache={cache}>
  <Navbar lang={lang} path={path} />
  <main class="pt-28 md:pt-36 px-5 md:px-6 pb-20">
    <div class="mx-auto max-w-3xl">
      <a href={`/${lang}/`} class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-[color:var(--color-accent-deep)] no-underline whitespace-nowrap mb-8 group">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[var(--dur-micro)] group-hover:-translate-x-0.5" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg>
        {t(lang, 'nav.home')}
      </a>
      <h1 class="text-display-s mb-3">{t(lang, 'blog.title')}</h1>
      <p class="text-[color:var(--color-muted)] mb-12">{t(lang, 'blog.sub')}</p>

      {posts.length === 0 ? (
        <p class="text-[14px] text-[color:var(--color-muted)]">{t(lang, 'blog.empty')}</p>
      ) : (
        <div class="space-y-4">
          {posts.map((post) => (
            <a
              href={`/${lang}/blog/${post.data.slug}`}
              class="group block rounded-(--radius-lg) border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] p-6 no-underline hover-lift"
            >
              <span class="mono text-[12px] text-[color:var(--color-muted)]">{fmtDate(post.data.date)}</span>
              <h2 class="mt-1.5 text-[20px] font-semibold">{post.data.title}</h2>
              <p class="mt-1 text-[14px] text-[color:var(--color-muted)]">{post.data.description}</p>
              <span class="mt-3 inline-flex items-center gap-1.5 text-[13px] font-semibold text-[color:var(--color-accent-deep)]">
                {t(lang, 'blog.readMore')}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-[var(--dur-micro)] group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer lang={lang} />
</Base>
