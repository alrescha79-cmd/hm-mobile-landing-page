---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { marked } from "marked";
import fs from "fs";
import path from "path";

const locale = "en" as const;

// Read markdown content
const noticePath = path.join(process.cwd(), "src/content/notice.en.md");
const markdownContent = fs.readFileSync(noticePath, "utf-8");

// Parse frontmatter
const frontmatterMatch = markdownContent.match(/^---\n([\s\S]*?)\n---/);
const frontmatter: Record<string, string> = {};
if (frontmatterMatch) {
  frontmatterMatch[1].split("\n").forEach((line) => {
    const [key, ...valueParts] = line.split(":");
    if (key && valueParts.length) {
      frontmatter[key.trim()] = valueParts.join(":").trim().replace(/^"|"$/g, "");
    }
  });
}

// Extract content after frontmatter
const content = markdownContent.replace(/^---\n[\s\S]*?\n---\n/, "");
const htmlContent = await marked(content);
---

<Layout locale={locale}>
  <Navbar locale={locale} />
  <main class="min-h-screen pt-24 pb-16 px-4">
    <article class="max-w-3xl mx-auto">
      <!-- Header -->
      <header class="mb-8 reveal">
        <p class="text-surface-500 dark:text-surface-400 text-sm mb-2">
          Last updated: {frontmatter.lastUpdated || "N/A"}
        </p>
        <h1 class="text-4xl md:text-5xl font-semibold text-surface-950 dark:text-surface-50 tracking-tight">
          {frontmatter.title || "Notice"}
        </h1>
      </header>

      <!-- Content -->
      <div
        class="notice-content glass-card p-8 md:p-12 reveal"
        set:html={htmlContent}
      />

      <!-- Back link -->
      <div class="mt-8 text-center reveal">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-primary-500 dark:text-accent-500 hover:text-primary-600 dark:hover:text-accent-400 font-medium transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Home
        </a>
      </div>
    </article>
  </main>
  <Footer locale={locale} />
</Layout>

<style>
  @reference "../styles/global.css";

  .notice-content :global(h2) {
    @apply text-2xl font-semibold text-surface-950 dark:text-surface-50 mt-8 mb-4 tracking-tight;
  }
  
  .notice-content :global(h3) {
    @apply text-xl font-medium text-surface-900 dark:text-surface-100 mt-6 mb-3;
  }
  
  .notice-content :global(h4) {
    @apply text-lg font-medium text-surface-800 dark:text-surface-200 mt-4 mb-2;
  }
  
  .notice-content :global(p) {
    @apply text-surface-700 dark:text-surface-300 leading-relaxed mb-4;
  }
  
  .notice-content :global(a) {
    @apply text-primary-500 dark:text-accent-500 hover:text-primary-600 dark:hover:text-accent-400 underline underline-offset-2 transition-colors;
  }
  
  .notice-content :global(ul),
  .notice-content :global(ol) {
    @apply my-4 pl-6 space-y-2;
  }
  
  .notice-content :global(ul) {
    @apply list-disc;
  }
  
  .notice-content :global(ol) {
    @apply list-decimal;
  }
  
  .notice-content :global(li) {
    @apply text-surface-700 dark:text-surface-300;
  }
  
  .notice-content :global(li strong) {
    @apply text-surface-900 dark:text-surface-100;
  }
  
  .notice-content :global(table) {
    @apply w-full my-6 border-collapse;
  }
  
  .notice-content :global(thead) {
    @apply border-b border-surface-200 dark:border-surface-700;
  }
  
  .notice-content :global(th) {
    @apply text-left py-3 px-4 text-surface-900 dark:text-surface-100 font-medium;
  }
  
  .notice-content :global(td) {
    @apply py-3 px-4 text-surface-700 dark:text-surface-300 border-b border-surface-100 dark:border-surface-800;
  }
  
  .notice-content :global(tr:last-child td) {
    @apply border-b-0;
  }
  
  .notice-content :global(hr) {
    @apply my-8 border-surface-200 dark:border-surface-700;
  }
  
  .notice-content :global(blockquote) {
    @apply pl-4 border-l-4 border-primary-500 dark:border-accent-500 my-6;
  }
  
  .notice-content :global(blockquote p) {
    @apply italic text-surface-600 dark:text-surface-400;
  }
  
  .notice-content :global(code) {
    @apply bg-surface-100 dark:bg-surface-800 px-1.5 py-0.5 rounded text-sm font-mono;
  }
  
  .notice-content :global(pre) {
    @apply bg-surface-100 dark:bg-surface-800 p-4 rounded-lg overflow-x-auto my-4;
  }
  
  .notice-content :global(pre code) {
    @apply bg-transparent p-0;
  }
  
  .notice-content :global(strong) {
    @apply font-semibold text-surface-900 dark:text-surface-100;
  }
  
  .notice-content :global(em) {
    @apply italic text-surface-600 dark:text-surface-400;
  }
</style>

<script>
  // Scroll reveal animation
  document.addEventListener('astro:page-load', () => {
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
          }
        });
      },
      { threshold: 0.1 }
    );
    reveals.forEach((el) => observer.observe(el));
  });
</script>
