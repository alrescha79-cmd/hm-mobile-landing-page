<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Huawei Manager Mobile</title>
    <script type="module" is:inline>
      const saved = localStorage.getItem('hm-lang');
      const accept = (navigator.language || 'en').toLowerCase();
      const lang = saved === 'id' || saved === 'en'
        ? saved
        : accept.startsWith('id') || accept.startsWith('ms')
          ? 'id'
          : 'en';
      location.replace(`/${lang}/`);
    </script>
    <noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>
  </head>
  <body>
    <p><a href="/en/">Huawei Manager Mobile →</a></p>
  </body>
</html>
