---
import type { Lang } from '@/i18n';
import { t } from '@/i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const isHomePage = path === `/${lang}/`;
const sectionHref = (id: string) => (isHomePage ? `#${id}` : `/${lang}/#${id}`);
const links = [
  { id: 'features', href: sectionHref('features'), label: t(lang, 'nav.features') },
  { id: 'how', href: sectionHref('how'), label: t(lang, 'nav.how') },
  { id: 'modems', href: sectionHref('modems'), label: t(lang, 'nav.modems') },
  { id: 'download', href: sectionHref('download'), label: t(lang, 'nav.download') },
  { id: 'faq', href: sectionHref('faq'), label: t(lang, 'nav.faq') },
];
const alt = lang === 'en' ? 'id' : 'en';
const altHref = path.replace(/^\/(en|id)/, '') === '' ? `/${alt}/` : `/${alt}${path.replace(/^\/(en|id)/, '')}`;
---

<!-- Desktop: N5 floating pill -->
<nav class="hidden md:block fixed top-5 inset-x-0 z-(--z-nav) px-4" aria-label="Primary">
  <div class="mx-auto max-w-5xl rounded-(--radius-pill) border border-[color:var(--color-rule)] bg-[color:var(--color-paper)]/85 backdrop-blur-xl shadow-(--shadow-soft)">
    <div class="flex items-center justify-between gap-3 px-5 py-2.5">
      <a href={`/${lang}/`} class="flex items-center gap-2.5 no-underline" aria-label="Huawei Manager Mobile home">
        <img src="/favicon.svg" width="24" height="24" alt="" class="rounded-md" aria-hidden="true" />
        <span class="font-display font-bold tracking-tight text-[15px]">Huawei Manager</span>
      </a>
      <div class="flex items-center gap-1">
        {links.map((l) => (
          <a
            href={l.href}
            class="px-3.5 py-2 text-[13px] font-medium text-[color:var(--color-muted)] hover:text-[color:var(--color-ink)] no-underline transition-colors duration-[var(--dur-micro)] rounded-(--radius-pill) whitespace-nowrap"
          >{l.label}</a>
        ))}
      </div>
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <a href={altHref} data-lang-switch={alt} class="px-3 py-2 text-[13px] font-semibold no-underline whitespace-nowrap" aria-label="Switch language">
          {alt === 'en' ? 'EN' : 'ID'}
        </a>
        <a
          href={sectionHref('download')}
          class="inline-flex items-center gap-1.5 rounded-(--radius-pill) bg-[color:var(--color-ink)] px-4 py-2 text-[13px] font-semibold text-[color:var(--color-paper)] no-underline whitespace-nowrap transition-[transform,background-color] duration-[var(--dur-micro)] ease-[var(--ease-out)] hover:-translate-y-px active:translate-y-0"
        >
          {t(lang, 'hero.ctaPrimary')}
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile: top bar (home left · lang + theme right) -->
<div class="md:hidden fixed top-0 inset-x-0 z-(--z-nav) px-4 pt-[max(env(safe-area-inset-top),10px)]" style="pointer-events: none">
  <div class="flex items-center justify-between gap-2 rounded-(--radius-pill) border border-[color:var(--color-rule)] bg-[color:var(--color-paper)]/85 px-3 py-2 backdrop-blur-xl shadow-(--shadow-soft)" style="pointer-events: auto">
    <a href={`/${lang}/`} class="flex items-center gap-2 no-underline" aria-label="Huawei Manager Mobile home">
      <img src="/favicon.svg" width="22" height="22" alt="" class="rounded-md" aria-hidden="true" />
      <span class="font-display font-bold tracking-tight text-[14px]">Huawei Manager</span>
    </a>
    <div class="flex items-center gap-2">
      <a href={altHref} data-lang-switch={alt} class="inline-flex items-center rounded-(--radius-pill) border border-[color:var(--color-rule)] bg-[color:var(--color-paper)]/80 px-2.5 py-1.5 text-[12px] font-semibold no-underline whitespace-nowrap" aria-label="Switch language">
        {alt === 'en' ? 'EN' : 'ID'}
      </a>
      <ThemeToggle />
    </div>
  </div>
</div>

<!-- Mobile: macOS-style bottom dock -->
<div class="md:hidden fixed bottom-0 inset-x-0 z-(--z-dock) px-3 pb-[max(env(safe-area-inset-bottom),12px)]" style="pointer-events: none">
  <nav class="dock mx-auto flex items-end justify-center gap-1.5 px-3 pt-2 pb-2 rounded-[28px] border border-[color:var(--color-rule)] bg-[color:var(--color-paper)]/85 backdrop-blur-xl shadow-(--shadow-soft)" style="pointer-events: auto" aria-label="Mobile navigation">
    {links.map((l, i) => (
      <a
        href={l.href}
        class="dock-item flex flex-col items-center gap-1 px-2 pb-1.5 no-underline"
        style={`--i: ${i}`}
        aria-label={l.label}
      >
        <span class="dock-tile flex h-10 w-10 items-center justify-center rounded-[12px]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {l.id === 'features' && <path d="M4 6h16M4 12h16M4 18h10" />}
            {l.id === 'how' && <><path d="M9 12l2 2 4-4" /><circle cx="12" cy="12" r="9" /></>}
            {l.id === 'modems' && <path d="M3 7h18M3 12h18M3 17h18M7 3v18M17 3v18" />}
            {l.id === 'download' && <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16" />}
            {l.id === 'faq' && <><path d="M4 6h16M4 12h16M4 18h10" /><circle cx="18" cy="18" r="2.5" /></>}
          </svg>
        </span>
        <span class="dock-label text-[9px] leading-none whitespace-nowrap">{l.label}</span>
      </a>
    ))}
  </nav>
</div>

<style>
  .dock-item {
    transition: transform var(--dur-short) var(--ease-out);
    transform-origin: bottom center;
  }
  .dock-tile {
    background: transparent;
    color: var(--color-ink);
    opacity: 0.55;
    transition: width var(--dur-short) var(--ease-out), height var(--dur-short) var(--ease-out),
      background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out),
      opacity var(--dur-micro) var(--ease-out), border-radius var(--dur-short) var(--ease-out);
    will-change: width, height;
  }
  .dock-label {
    color: var(--color-ink);
    transition: color var(--dur-micro) var(--ease-out), opacity var(--dur-micro) var(--ease-out);
  }
  .dock-item.active .dock-tile {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 16px;
    background: var(--color-ink);
    color: var(--color-paper);
    opacity: 1;
  }
  .dock-item.active .dock-label { color: var(--color-ink); font-weight: 600; opacity: 1; }
  @media (max-width: 24rem) {
    .dock { gap: 2px; padding-left: 6px; padding-right: 6px; }
    .dock-item { padding-left: 2px; padding-right: 2px; }
    .dock-label { font-size: 8px; }
  }
</style>

<script>
  const init = () => {
    const nav = document.querySelector('.dock') as HTMLElement | null;
    if (!nav || (nav as any).dataset.dockInit) return;
    (nav as any).dataset.dockInit = 'true';

    const items = Array.from(nav.querySelectorAll('.dock-item')) as HTMLElement[];
    if (!items.length) return;
    const setActive = (href: string) => items.forEach((it) => it.classList.toggle('active', it.getAttribute('href') === href));
    const localLinks = items.map((it) => it.getAttribute('href')).filter((h): h is string => !!h && h.startsWith('#'));
    const sections = localLinks.map((h) => document.querySelector(h)).filter(Boolean) as Element[];
    if (localLinks.length) setActive(location.hash && localLinks.includes(location.hash) ? location.hash : localLinks[0]);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive(`#${e.target.id}`);
        }
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );
    sections.forEach((s) => observer.observe(s));

    if (window.matchMedia('(pointer: fine)').matches) {
      nav.addEventListener('pointermove', (ev: PointerEvent) => {
        const dockItems = Array.from(nav.querySelectorAll('.dock-item')) as HTMLElement[];
        for (const item of dockItems) {
          const r = item.getBoundingClientRect();
          const dist = Math.abs(ev.clientX - (r.left + r.width / 2));
          const scale = Math.min(1.55, Math.max(1, 1.55 - dist / 90));
          item.style.transform = `scale(${scale})`;
        }
      });
      nav.addEventListener('pointerleave', () => {
        const dockItems = Array.from(nav.querySelectorAll('.dock-item')) as HTMLElement[];
        for (const item of dockItems) item.style.transform = '';
      });
    }
  };

  document.addEventListener('astro:page-load', init);
</script>
