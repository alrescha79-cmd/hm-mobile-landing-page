---
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---
<button
  type="button"
  data-theme-toggle
  data-mode="auto"
  class={`inline-flex items-center gap-1.5 rounded-(--radius-pill) border border-[color:var(--color-rule)] bg-[color:var(--color-paper)]/80 px-2.5 py-1.5 text-[12px] font-medium text-[color:var(--color-muted)] no-underline whitespace-nowrap transition-colors duration-[var(--dur-micro)] hover:text-[color:var(--color-ink)] ${cls ?? ''}`}
  aria-label="Theme: auto"
>
  <svg class="icon icon-light w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" /></svg>
  <svg class="icon-dark w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
  <svg class="icon-auto w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8m-4-4v4" /></svg>
  <span class="lbl-light">Light</span>
  <span class="lbl-dark">Dark</span>
  <span class="lbl-auto">Auto</span>
</button>

<style>
  .icon-light, .icon-dark, .icon-auto, .lbl-light, .lbl-dark, .lbl-auto { display: none; }
  [data-theme-toggle][data-mode="light"] .icon-light,
  [data-theme-toggle][data-mode="dark"] .icon-dark,
  [data-theme-toggle][data-mode="auto"] .icon-auto { display: block; }
  [data-theme-toggle][data-mode="light"] .lbl-light,
  [data-theme-toggle][data-mode="dark"] .lbl-dark,
  [data-theme-toggle][data-mode="auto"] .lbl-auto { display: inline; }
</style>