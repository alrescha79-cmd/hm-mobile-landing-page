---
import type { Lang } from '@/i18n';
import { t } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const icons: Record<string, string> = {
  dashboard: 'M3 3h7v7H3zM14 3h7v10h-7zM3 14h7v7H3zM14 14h7v7h-7z',
  signalFinder: 'M12 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM6 9a9 9 0 0 1 9 9M3 6a12 12 0 0 1 12 12M15 6a12 12 0 0 1 6 6',
  bandLock: 'M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01Z',
  wifi: 'M5 12.55a11 11 0 0 1 14 0M8.5 16.1a6 6 0 0 1 7 0M2 9a16 16 0 0 1 20 0M9 19.5l3-3 3 3a3 3 0 0 1-6 0Z',
  guest: 'M5 12.55a11 11 0 0 1 14 0M8.5 16.1a6 6 0 0 1 7 0M12 22v-6m0-4 2.5 2.5M12 12l-2.5 2.5M16 7h.01M8 7h.01M12 3l1 2 2 1-2 1-1 2-1-2-2-1 2-1Z',
  parental: 'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6ZM9 12l2 2 4-4',
  sms: 'M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1 0-2-.17-2.9-.5L3 21l1.5-5.6A8.5 8.5 0 1 1 21 11.5ZM8 10h8M8 14h5',
  network: 'M12 12a9 9 0 0 1 9-9M12 12 21 3M12 12l-9 9a9 9 0 0 1 9-9ZM12 12a9 9 0 0 0 9 9M12 12l9 9M12 12 3 3a9 9 0 0 1 9 9Z',
  widget: 'M3 5h18v14H3zM3 10h18M9 17h6',
  notify: 'M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9ZM13.73 21a2 2 0 0 1-3.46 0',
  speedtest: 'M4 20 20 4M4 4h6v16H4zM20 4v16h-6V4z',
  debug: 'M14 4a3 3 0 1 1-4 0M8 21h8M12 4v6M10 7l2-1 2 1',
  privacy: 'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6ZM9 12l2 2 4-4',
};
const order = ['dashboard', 'signalFinder', 'bandLock', 'wifi', 'guest', 'parental', 'sms', 'network', 'widget', 'notify', 'speedtest', 'debug', 'privacy'];
---

<section id="features" class="px-5 md:px-6 py-16 md:py-24 scroll-mt-24 border-t border-[color:var(--color-rule)]">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 md:mb-14 flex flex-col gap-4 max-w-2xl" data-reveal>
      <p class="mono text-[12px] uppercase tracking-[0.14em] text-[color:var(--color-accent-deep)]">{t(lang, 'features.label')}</p>
      <h2 class="text-display-s">{t(lang, 'features.title')}</h2>
      <p class="text-[color:var(--color-muted)]">{t(lang, 'features.sub')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-0">
      {order.filter((k) => k !== 'privacy').map((k, i) => (
        <article class="flex items-start gap-4 py-6 border-t border-[color:var(--color-rule)]" data-reveal data-reveal-delay={String(Math.min(i % 6 + 1, 6))}>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] text-[color:var(--color-accent-deep)]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[k]} /></svg>
          </span>
          <div class="min-w-0">
            <h3 class="text-lg font-bold tracking-tight">{t(lang, `features.${k}.title`)}</h3>
            <p class="text-[color:var(--color-muted)] text-[15px] mt-1 leading-relaxed">{t(lang, `features.${k}.desc`)}</p>
          </div>
        </article>
      ))}
    </div>

    <article class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 py-6 border-t border-[color:var(--color-rule)]">
      <div class="flex items-center gap-4 md:w-72 md:shrink-0">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] text-[color:var(--color-accent-deep)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.privacy} /></svg>
        </span>
        <h3 class="text-lg font-bold tracking-tight">{t(lang, 'features.privacy.title')}</h3>
      </div>
      <p class="text-[color:var(--color-muted)] text-[15px] leading-relaxed max-w-[52ch]">{t(lang, 'features.privacy.desc')}</p>
    </article>
  </div>
</section>
