---
import { Image } from "astro:assets";
import type { Locale } from "../i18n/i18n";
import { t } from "../i18n/i18n";

import deviceRouterDark from "../assets/images/device-router-dark.png";
import deviceRouterLight from "../assets/images/device-router-light.png";
import deviceMifiDark from "../assets/images/device-mifi-dark.png";
import deviceMifiLight from "../assets/images/device-mifi-light.png";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

const deviceGroups = [
  {
    type: "router" as const,
    imageDark: deviceRouterDark,
    imageLight: deviceRouterLight,
    models: ["B310", "B311", "B312", "etc."],
  },
  {
    type: "mifi" as const,
    imageDark: deviceMifiDark,
    imageLight: deviceMifiLight,
    models: ["E5573", "E5577", "etc."],
  },
];
---

<section id="devices" class="py-20 sm:py-32 relative section-glow">
  <div class="absolute inset-0 -z-10">
    <div
      class="absolute top-0 inset-x-0 h-px bg-linear-to-r from-transparent via-surface-200 dark:via-surface-800 to-transparent"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal text-center max-w-3xl mx-auto mb-16">
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight"
      >
        {i.devices.sectionTitle}
      </h2>
      <p class="mt-4 text-lg text-surface-500 dark:text-surface-400">
        {i.devices.sectionDescription}
      </p>
    </div>

    <div class="reveal-group grid sm:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {
        deviceGroups.map((group, gIdx) => (
          <div
            class="glass-card p-8 text-center group"
          >
            <div class="relative w-48 h-48 mx-auto mb-6">
              <div class="absolute inset-0 bg-primary-500/5 dark:bg-accent-500/5 rounded-2xl blur-xl" />
              <Image
                src={group.imageDark}
                alt={`${i.devices[group.type]} - Huawei LTE Modem (Dark)`}
                class="relative w-full h-full object-contain drop-shadow-lg rounded-xl hidden dark:block transition-transform duration-500 group-hover:scale-105 group-hover:-translate-y-1"
                format="avif"
                width={192}
                quality={80}
                loading="lazy"
              />
              <Image
                src={group.imageLight}
                alt={`${i.devices[group.type]} - Huawei LTE Modem (Light)`}
                class="relative w-full h-full object-contain drop-shadow-lg rounded-xl block dark:hidden transition-transform duration-500 group-hover:scale-105 group-hover:-translate-y-1"
                format="avif"
                width={192}
                quality={80}
                loading="lazy"
              />
            </div>
            <h3 class="text-lg font-semibold text-surface-950 dark:text-surface-50 mb-2">
              {i.devices[group.type]}
            </h3>
            <div class="flex flex-wrap justify-center gap-2 mt-4">
              {group.models.map((model) => (
                <span class="px-3 py-1.5 text-sm font-medium rounded-full bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-400">
                  {model}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <p
      class="reveal text-center mt-8 text-sm text-surface-400 dark:text-surface-500"
    >
      {i.devices.andMore}
    </p>

    <div class="reveal mt-8 text-center">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/10 dark:bg-accent-500/10 transition-all duration-300 hover:bg-primary-500/15 dark:hover:bg-accent-500/15 hover:scale-[1.02]"
      >
        <svg
          class="w-4 h-4 text-primary-500 dark:text-accent-500"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-sm font-medium text-primary-600 dark:text-accent-500"
          >{i.devices.testedOn}
        </span>
      </div>
    </div>
  </div>
</section>
