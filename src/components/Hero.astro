---
import type { Lang } from '@/i18n';
import { t } from '@/i18n';
import { github } from '@/data/site';
import type { ReleasesCache } from '@/data/types';
import logo from '@/assets/logo.png';
import { Image } from 'astro:assets';

interface Props {
  lang: Lang;
  cache?: ReleasesCache;
}

const { lang } = Astro.props;
---

<header class="relative pt-28 md:pt-36 pb-14 md:pb-20 px-5 md:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-10 lg:gap-14 items-center">
      <div>
        <div class="inline-flex items-center gap-2 rounded-(--radius-pill) border border-[color:var(--color-rule)] bg-[color:var(--color-paper-2)] px-3.5 py-1.5 mb-6" data-reveal>
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-[color:var(--color-success)] opacity-60 animate-ping" style="animation-duration:2.4s"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[color:var(--color-success)]"></span>
          </span>
          <span class="text-[13px] font-medium text-[color:var(--color-muted)]">{t(lang, 'hero.badge')}</span>
        </div>

        <h1 class="text-display mb-5" data-reveal data-reveal-delay="1">{t(lang, 'hero.title')}</h1>

        <p class="text-[1.0625rem] text-[color:var(--color-muted)] mb-8 leading-relaxed max-w-[52ch]" data-reveal data-reveal-delay="2">{t(lang, 'hero.sub')}</p>

        <div class="flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="3">
          <a
            id="hero-download-arm64"
            href={`${github.rawReleases}/huawei-manager-arm64-v8a.apk`}
            download
            class="inline-flex items-center gap-2 rounded-(--radius-pill) bg-[color:var(--color-ink)] px-6 py-3.5 text-[15px] font-semibold text-[color:var(--color-paper)] no-underline whitespace-nowrap transition-[transform,background-color] duration-[var(--dur-micro)] ease-[var(--ease-out)] hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-2"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16" /></svg>
            {t(lang, 'hero.ctaPrimary')}
          </a>
          <a
            href="#download"
            class="inline-flex items-center gap-2 rounded-(--radius-pill) border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] px-6 py-3.5 text-[15px] font-semibold text-[color:var(--color-ink)] no-underline whitespace-nowrap transition-[border-color,background-color] duration-[var(--dur-micro)] ease-[var(--ease-out)] hover:border-[color:var(--color-neutral)]"
          >
            {t(lang, 'hero.ctaSecondary')}
          </a>
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-[color:var(--color-muted)]" data-reveal data-reveal-delay="4">
          <span class="inline-flex items-center gap-1.5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01Z" /></svg>
            <strong class="mono font-medium text-[color:var(--color-ink)]" data-hero-stat="stars">—</strong>
            {t(lang, 'stats.stars')}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 21h16" /></svg>
            <strong class="mono font-medium text-[color:var(--color-ink)]" data-hero-stat="downloads">—</strong>
            {t(lang, 'stats.downloads')}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" /><path d="M12 18h.01" /></svg>
            <strong class="mono font-medium text-[color:var(--color-ink)]" data-hero-stat="latest">—</strong>
            <span>· {t(lang, 'hero.trust')}</span>
          </span>
        </div>
      </div>

      <div class="hidden lg:flex justify-center">
          <div class="relative w-[300px]" style="animation: float 4s ease-in-out infinite">
          <div class="rounded-[24px] border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] p-8 text-center shadow-(--shadow-hero)">
            <div class="mx-auto mb-5 w-[160px] h-[160px] rounded-[20px] bg-[color:var(  )] overflow-hidden">
              <Image src={logo} alt="Huawei Manager Mobile logo" width={160} height={160} format="webp" quality={80} class="w-full h-full object-cover" />
            </div>
            <p class="font-display text-lg font-bold tracking-tight">Huawei Manager</p>
            <p class="mono text-[13px] text-[color:var(--color-muted)] mt-1" data-hero-stat="latest">—</p>
            <div class="mt-5 h-px bg-[color:var(--color-rule)]"></div>
            <div class="mt-5 flex items-center justify-center gap-2">
              <span class="inline-flex items-center gap-1 text-[13px] font-semibold text-[color:var(--color-accent-deep)]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" /><path d="M6 9a9 9 0 0 1 9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                Signal finder
              </span>
              <span class="inline-flex items-center gap-1 text-[13px] font-semibold text-[color:var(--color-accent-deep)]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01Z" /></svg>
                Band lock
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  (() => {
    type ReleaseAsset = { name: string; url: string; downloads?: number; size?: number };
    type Release = { tag: string; prerelease: boolean; assets: ReleaseAsset[] };
    type ReleasesCache = { releases: Release[]; stars: number };
    const fetchLive = async () => {
      try {
        const res = await fetch('/api/releases');
        if (!res.ok) throw new Error(String(res.status));
        const data = (await res.json()) as ReleasesCache & { releases: (Release & { assets: ReleaseAsset[] })[] };
        const totalDownloads = data.releases.reduce((sum: number, r: Release) => sum + r.assets.reduce((s: number, a: ReleaseAsset) => s + (a.downloads ?? 0), 0), 0);
        const latest = data.releases.find((r: Release) => !r.prerelease && r.tag.startsWith('v'));
        const lang = document.documentElement.lang || 'en';
        const fmt = (n: number) => new Intl.NumberFormat(lang === 'id' ? 'id-ID' : 'en-US').format(n);
        document.querySelectorAll('[data-hero-stat="stars"]').forEach((el) => { el.textContent = fmt(data.stars ?? 0); });
        document.querySelectorAll('[data-hero-stat="downloads"]').forEach((el) => { el.textContent = fmt(totalDownloads); });
        document.querySelectorAll('[data-hero-stat="latest"]').forEach((el) => { el.textContent = latest?.tag ?? '—'; });
        const arm64 = latest?.assets.find((a: ReleaseAsset) => a.name.includes('arm64-v8a'));
        const anchor = document.getElementById('hero-download-arm64') as HTMLAnchorElement | null;
        if (anchor && arm64?.url) anchor.setAttribute('href', arm64.url);
      } catch {}
    };
    if (!window.__hmHeroFetch) {
      window.__hmHeroFetch = true;
      document.addEventListener('astro:page-load', fetchLive);
      setInterval(fetchLive, 60 * 60 * 1000);
    }
  })();
</script>
