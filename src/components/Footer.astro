---
import type { Lang } from '@/i18n';
import { t } from '@/i18n';
import { github } from '@/data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const alt = lang === 'en' ? 'id' : 'en';
---

<footer class="px-5 md:px-6 pt-16 pb-32 md:pb-16 border-t border-[color:var(--color-rule)]">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-8">
      <p class="font-display text-2xl md:text-3xl font-bold tracking-tight max-w-[22ch] leading-tight">
        {t(lang, 'footer.statement')}
      </p>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[14px]">
        <a href={`/${lang}/`} class="font-semibold no-underline whitespace-nowrap">Huawei Manager</a>
        <a href="#download" class="text-[color:var(--color-muted)] no-underline whitespace-nowrap hover:text-[color:var(--color-ink)]">{t(lang, 'nav.download')}</a>
        <a href="#features" class="text-[color:var(--color-muted)] no-underline whitespace-nowrap hover:text-[color:var(--color-ink)]">{t(lang, 'nav.features')}</a>
        <a href={`/${lang}/releases`} class="text-[color:var(--color-muted)] no-underline whitespace-nowrap hover:text-[color:var(--color-ink)]">{t(lang, 'nav.releases')}</a>
        <a href={`/${lang}/blog`} class="text-[color:var(--color-muted)] no-underline whitespace-nowrap hover:text-[color:var(--color-ink)]">{t(lang, 'nav.blog')}</a>
        <a href={github.issues} class="text-[color:var(--color-muted)] no-underline whitespace-nowrap hover:text-[color:var(--color-ink)]">{t(lang, 'footer.docs')}</a>
        <a href={github.issues} class="text-[color:var(--color-muted)] no-underline whitespace-nowrap hover:text-[color:var(--color-ink)]">{t(lang, 'footer.sponsor')}</a>
        <a href={`/${alt}/`} data-lang-switch={alt} class="text-[color:var(--color-muted)] no-underline whitespace-nowrap hover:text-[color:var(--color-ink)]">{alt.toUpperCase()}</a>
      </div>

      <div class="h-px bg-[color:var(--color-rule)]"></div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 text-[12px] text-[color:var(--color-muted)]">
        <p class="flex items-center gap-1.5">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6Z" /></svg>
          {t(lang, 'footer.local')}
        </p>
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <span>{t(lang, 'footer.sub')}</span>
          <span class="hidden sm:inline w-px h-3 bg-[color:var(--color-rule)]"></span>
          <span>{t(lang, 'footer.rights')}</span>
          <span class="hidden sm:inline w-px h-3 bg-[color:var(--color-rule)]"></span>
          <span>© {year} · {t(lang, 'footer.license')}</span>
        </p>
      </div>
    </div>
  </div>
</footer>
